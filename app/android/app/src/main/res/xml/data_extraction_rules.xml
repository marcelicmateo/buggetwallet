<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing of the app is copied to the cloud or to another phone. The wallet database, the key and the logs
     stay on the device; a new phone gets the wallet back from the key plus the relay, or from a .bwb backup file. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
        <exclude domain="device_root"/>
        <exclude domain="device_file"/>
        <exclude domain="device_database"/>
        <exclude domain="device_sharedpref"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="file"/>
        <exclude domain="database"/>
        <exclude domain="sharedpref"/>
        <exclude domain="external"/>
        <exclude domain="device_root"/>
        <exclude domain="device_file"/>
        <exclude domain="device_database"/>
        <exclude domain="device_sharedpref"/>
    </device-transfer>
</data-extraction-rules>
