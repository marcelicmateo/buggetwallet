<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press shortcut on the launcher icon: opens the app on the Add expense sheet (P13). MainActivity forwards the extra
     `bw.action` to the app; with no wallet open (first run, locked) the app ignores it. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_expense"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="hr.marcelic.budget_wallet.MainActivity"
            android:targetPackage="hr.marcelic.budget_wallet">
            <extra android:name="bw.action" android:value="addExpense"/>
        </intent>
    </shortcut>
</shortcuts>
