# Budget Wallet build environment: Flutter + Android SDK, run with rootless Podman by tools/build.sh.
# Can do: package tests, app analyze/tests, format/shell/workflow lint, Dart LSP, Android APK, Linux desktop build,
# Linux desktop integration tests and release smoke test under Xvfb.
# Cannot do: iOS / macOS builds — those need a Mac with Xcode.
FROM docker.io/library/ubuntu:24.04

ARG FLUTTER_VERSION
ARG ANDROID_CMDLINE_TOOLS=13114758

# Rootless Podman cannot map the archive owners in Flutter's downloads; extract as the current user
ENV DEBIAN_FRONTEND=noninteractive \
    TAR_OPTIONS=--no-same-owner \
    FLUTTER_HOME=/opt/flutter \
    ANDROID_HOME=/opt/android-sdk \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    PUB_CACHE=/cache/pub \
    GRADLE_USER_HOME=/cache/gradle \
    ANDROID_USER_HOME=/cache/android
ENV PATH=$FLUTTER_HOME/bin:$FLUTTER_HOME/bin/cache/dart-sdk/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH

# Basics and JDK 17 for Gradle. The Linux packages here are repeated in dev/linux-packages.txt (installed below);
# that list is the source of truth, they stay here only so this layer and the Flutter/Android layers stay cached.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git unzip xz-utils zip file \
      openjdk-17-jdk-headless \
      clang cmake ninja-build pkg-config libgtk-3-dev liblzma-dev libstdc++-12-dev \
      libsqlite3-dev sqlite3 libsecret-1-dev \
 && rm -rf /var/lib/apt/lists/*

RUN test -n "$FLUTTER_VERSION" \
 && git clone --quiet --depth 1 --branch "$FLUTTER_VERSION" https://github.com/flutter/flutter.git "$FLUTTER_HOME" \
 && git config --system --add safe.directory '*' \
 && flutter config --no-analytics \
 && dart --disable-analytics \
 && flutter precache --android --linux

# Android SDK: the compileSdk and NDK versions this Flutter release asks for, so Gradle never downloads them
RUN mkdir -p "$ANDROID_HOME/cmdline-tools" \
 && curl -fsSL -o /tmp/tools.zip "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_TOOLS}_latest.zip" \
 && unzip -q /tmp/tools.zip -d /tmp/tools \
 && mv /tmp/tools/cmdline-tools "$ANDROID_HOME/cmdline-tools/latest" \
 && rm -rf /tmp/tools /tmp/tools.zip \
 && ext="$FLUTTER_HOME/packages/flutter_tools/gradle/src/main/kotlin/FlutterExtension.kt" \
 && sdk=$(grep -oP 'val compileSdkVersion\s*:\s*Int\s*=\s*\K[0-9]+' "$ext") \
 && ndk=$(grep -oP 'val ndkVersion\s*:\s*String\s*=\s*"\K[^"]+' "$ext") \
 && echo "compileSdk=$sdk ndk=$ndk" \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager "platform-tools" "platforms;android-$sdk" "ndk;$ndk" >/dev/null \
 && yes | flutter doctor --android-licenses >/dev/null

# What the Android build (AGP + plugins) installs on first use; baked in so `--rm` containers don't redownload it
RUN sdkmanager "build-tools;36.0.0" "platforms;android-35" "cmake;3.22.1" >/dev/null

# Linux desktop toolchain and headless display (Xvfb, Mesa, D-Bus, fonts): the list CI installs too. Late in the
# file, so editing the list only rebuilds from here.
COPY linux-packages.txt /tmp/
RUN apt-get update \
 && sed 's/#.*//' /tmp/linux-packages.txt | xargs apt-get install -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/* /tmp/linux-packages.txt

# shellcheck + actionlint, pinned and checksummed; CI installs them with the same script
COPY install-lint-tools.sh /tmp/
RUN /tmp/install-lint-tools.sh /usr/local/bin && rm /tmp/install-lint-tools.sh

# Google Chrome stable (web builds' `flutter test --platform chrome`, tools/web.sh shot). The .deb from dl.google.com, no snap.
# Root in a rootless container can't use Chrome's sandbox, so CHROME_EXECUTABLE is a wrapper that adds --no-sandbox.
RUN curl -fsSL -o /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
 && apt-get update && apt-get install -y --no-install-recommends /tmp/chrome.deb \
 && rm -rf /var/lib/apt/lists/* /tmp/chrome.deb \
 && printf '#!/bin/sh\nexec /opt/google/chrome/chrome --no-sandbox --disable-gpu --disable-dev-shm-usage "$@"\n' > /usr/local/bin/chrome-bw \
 && chmod +x /usr/local/bin/chrome-bw
ENV CHROME_EXECUTABLE=/usr/local/bin/chrome-bw

# Rootless Podman: root in here is the host user. Flutter's "running as root" warning is skipped in containers it
# recognizes by this marker file (it only checks for /.dockerenv).
RUN touch /.dockerenv

WORKDIR /work
CMD ["bash"]
