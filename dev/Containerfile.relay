# Budget Wallet relay (relay/): one self-contained executable on a small base.
#   podman build -f dev/Containerfile.relay -t localhost/budget-wallet-relay .   (tools/relay.sh does this)
# Build stage: the official `dart` image at the Dart version bundled in the pinned Flutter (app/pubspec.yaml,
# Flutter 3.47.7 = Dart 3.13.5), so the relay is compiled by the same compiler as the rest, without dragging the
# multi-GB Flutter/Android dev image into a server build. Bump DART_VERSION together with the Flutter pin.
ARG DART_VERSION=3.13.5
FROM docker.io/library/dart:${DART_VERSION} AS build
WORKDIR /src
COPY relay/pubspec.yaml relay/pubspec.lock ./
RUN dart pub get --enforce-lockfile
COPY relay/bin bin
COPY relay/lib lib
RUN dart compile exe bin/relay.dart -o /relay

# Runtime: the AOT executable needs only glibc.
FROM docker.io/library/debian:bookworm-slim
RUN useradd --system --uid 10001 --no-create-home --shell /usr/sbin/nologin relay \
 && mkdir /data && chown relay /data
COPY --from=build /relay /usr/local/bin/relay
USER relay
# Settings by environment (BW_RELAY_HOST/PORT/ORIGINS/MAX_WALLETS/MAX_BYTES/CREATE_TOKEN(_FILE)/TRUST_PROXY, see relay/bin/relay.dart) or flags after the image name.
ENV BW_RELAY_HOST=0.0.0.0 BW_RELAY_PORT=8787
EXPOSE 8787
VOLUME /data
# The slim image has no curl: the relay binary checks itself (GET http://127.0.0.1:$BW_RELAY_PORT/v2/health, exit 0 or 1).
# Podman keeps HEALTHCHECK only with `podman build --format docker`.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["relay", "--health-check"]
# Runs read-only except /data (podman run --read-only): the relay writes nothing else.
ENTRYPOINT ["relay", "--data", "/data"]
