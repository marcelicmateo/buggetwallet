# Caddy in front of the relay: automatic HTTPS (Let's Encrypt) for BW_RELAY_DOMAIN and HTTP to HTTPS redirect.
# Copy to ~/.config/containers/systemd/. Only 80 and 443 are published; nothing else of this host is reachable from outside.
# Rootless Podman cannot bind ports below 1024 by default: sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80
# (persist it in /etc/sysctl.d/), or publish high ports here (8080/8443) and forward 80/443 to them on the router.
[Unit]
Description=Budget Wallet relay: Caddy (HTTPS)
Requires=bw-relay.service
After=bw-relay.service

[Container]
Image=docker.io/library/caddy:2
ContainerName=bw-relay-caddy
Network=bw-relay.network
PublishPort=80:80
PublishPort=443:443
# BW_RELAY_DOMAIN: the same file as the relay's (see bw-relay.env.example); Caddy only uses that one variable.
EnvironmentFile=%h/.config/budget-wallet-relay/bw-relay.env
Volume=%h/.config/budget-wallet-relay/Caddyfile:/etc/caddy/Caddyfile:ro,z
# Certificates and the ACME account: keep them, Let's Encrypt limits how often a name can be issued.
Volume=bw-caddy-data:/data
Volume=bw-caddy-config:/config
ReadOnly=true
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true

[Service]
Restart=always

[Install]
WantedBy=default.target
