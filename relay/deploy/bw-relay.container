# The relay (docs/setup.md section 5). Copy to ~/.config/containers/systemd/ (rootless, user systemd).
# No PublishPort: the relay port (8787) is never exposed on the host or the router; Caddy reaches it on the private network.
[Unit]
Description=Budget Wallet relay

[Container]
Image=localhost/budget-wallet-relay:latest
ContainerName=bw-relay
Network=bw-relay.network
# The only writable place. The container user (uid 10001) is mapped to your user, so the folder stays yours.
Volume=/srv/budget-wallet-relay:/data:z
UserNS=keep-id:uid=10001,gid=10001
# BW_RELAY_DOMAIN (also the relay's public host), BW_RELAY_TRUST_PROXY, BW_RELAY_CREATE_TOKEN, limits: see bw-relay.env.example
# (copy to bw-relay.env, chmod 600). The relay reads BW_RELAY_DOMAIN as its --public-host unless BW_RELAY_PUBLIC_HOST is set.
EnvironmentFile=%h/.config/budget-wallet-relay/bw-relay.env
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=relay --health-check
HealthInterval=30s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=3

[Service]
Restart=always

[Install]
WantedBy=default.target
