# Copy to ~/.config/budget-wallet-relay/bw-relay.env and run chmod 600 on it. Read by both containers
# (bw-relay.container and bw-relay-caddy.container).

# The public name of this server: your own domain or a dynamic-DNS name that points at your router. The address you enter in the
# app is https:// plus this name. Caddy gets the certificate for it and the relay uses it as its public host (the host that signed
# requests must be addressed to). The one place the name is set. Placeholder only: put your own name in your copy, never in git.
BW_RELAY_DOMAIN=wallet.example.org

# Behind Caddy: take the client address from X-Forwarded-For (rate limit). Never set it when the relay is reachable directly.
BW_RELAY_TRUST_PROXY=1

# Wallet creation needs this token (at least 16 characters; the app sends it as X-BW-Create-Token when it creates a wallet on
# this relay). Generate one with: openssl rand -base64 24
# Without it anyone who can reach the relay can create a wallet: development mode only.
BW_RELAY_CREATE_TOKEN=replace-with-a-long-random-token

# Optional limits (defaults: 16 wallets, 1 GiB per wallet).
#BW_RELAY_MAX_WALLETS=16
#BW_RELAY_MAX_BYTES=1073741824
