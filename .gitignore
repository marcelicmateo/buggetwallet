# Bank exports and real financial data — never commit
*.xls
*.xlsx
*.csv
*.pdf
*.ofx
*.qif
data/
exports/
private/

# Test fixtures must be synthetic; allow them explicitly
!tests/fixtures/**

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node / build
node_modules/
dist/
.env
.env.*

# Flutter / Dart
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.apk
*.aab
*.ipa
*.jks
*.keystore
key.properties

# Synthetic test fixtures inside Dart packages are allowed
!**/test/fixtures/**

# Claude Code: per-machine settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# Lockfiles of the internal Dart packages (the app lockfile is committed)
packages/*/pubspec.lock
